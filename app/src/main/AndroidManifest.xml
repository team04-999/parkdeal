<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- 권한은 쓰는 기능을 넣는 PR 에서 그 기능에 필요한 것만 추가한다 -->
    <!-- 주차 데이터 API 호출 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 기어(P 진입·출차) 읽기: Pleos Vehicle SDK -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 전기차 여부(배터리 잔량을 읽을 수 있는지): 전기차 불가 주차장 거르기 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 내비 목적지 받기와 주차장으로 경로 바꾸기: Pleos NaviHelper -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 음성 안내: Pleos TextToSpeech -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 음성으로 묻기: Pleos SpeechToText(온디바이스). 차량 마이크 음성을 외부로 보내지 않는다 -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 화면이 가려진 주행 중에도 기어를 받고 출차 알림을 보낸다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:exported="true">
            <!-- 주행 중에도 화면을 쓴다. 대신 주행 제한(CarUxRestrictions)이 걸리면 고른 곳 하나와
                 짧은 목록만 보여준다 (docs/architecture.md, docs/pleos-guidelines.md 1장) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".parking.ParkingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tracks the parking session by gear changes and reminds the driver to register store parking benefits on exit" />
        </service>
    </application>
</manifest>
